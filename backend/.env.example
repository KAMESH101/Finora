# Auth
JWT_SECRET_KEY=changeme-generate-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# Database
DATABASE_PATH=./data/finora.db

# LLM providers (Gemini primary, Ollama automatic fallback)
# Leave GEMINI_API_KEY empty to skip straight to the local Ollama fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=20
OLLAMA_TIMEOUT_SECONDS=35
OLLAMA_WARMUP_TIMEOUT_SECONDS=90

# Security
CREDIT_UTILIZATION_WARNING_THRESHOLD=80
